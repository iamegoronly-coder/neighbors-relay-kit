--- /dev/null
+++ b/src/RelayEventExpiry.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include "golpe.h"
+#include "PackedEvent.h"
+
+// Read-time policy is independent of asynchronous physical deletion.
+inline bool relayEventExpired(const PackedEventView &event) {
+    const auto now = hoytech::curr_time_s();
+    const auto expiry = event.expiration();
+    if (expiry > 1 && expiry <= now) return true;
+    const auto lifetime = expiry == 1 ? cfg().events__ephemeralEventsLifetimeSeconds
+                                      : cfg().events__rejectEventsOlderThanSeconds;
+    return event.created_at() <= now && now - event.created_at() >= lifetime;
+}
