#!/usr/bin/env python3
"""Prune the 48-hour history with strfry's indexed age deletion.

Pinned strfry's RelayCron handles ephemeral/NIP-40 expiry every nine seconds
using the expiration index. The required neighbors patch also lets that cron
remove the newest record safely. Do not scan/deserialize the whole DB here.
The systemd ExecStartPost writes last-prune only after this command succeeds;
that stamp proves age maintenance, not the health of the internal expiry cron.
"""

import argparse
import subprocess


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--binary", default="/usr/local/bin/strfry")
    parser.add_argument("--config", default="/etc/strfry/strfry.conf")
    parser.add_argument("--age-seconds", type=int, default=172800)
    args = parser.parse_args()
    if args.age_seconds <= 0:
        parser.error("--age-seconds must be positive")
    subprocess.run(
        [args.binary, "--config", args.config, "--verbosity=WARNING",
         "delete", "--age", str(args.age_seconds)],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    print("strfry-prune-events: age maintenance completed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
