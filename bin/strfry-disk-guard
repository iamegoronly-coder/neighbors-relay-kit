#!/usr/bin/env python3
"""Stop only strfry before its LMDB consumes the shared root filesystem."""

import argparse
import os
import subprocess
import sys
from pathlib import Path

DATABASE_DIR = Path("/var/lib/strfry/db")
MAX_DATABASE_BYTES = 1536 * 1024 * 1024
MIN_FREE_BYTES = 2 * 1024 * 1024 * 1024


def usage(database_dir: Path) -> tuple[int, int]:
    data_bytes = sum(path.stat().st_size for path in database_dir.iterdir() if path.is_file())
    free_bytes = os.statvfs(database_dir).f_bavail * os.statvfs(database_dir).f_frsize
    return data_bytes, free_bytes


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("check", "enforce"))
    parser.add_argument("--database-dir", type=Path, default=DATABASE_DIR)
    parser.add_argument("--max-bytes", type=int, default=MAX_DATABASE_BYTES)
    parser.add_argument("--min-free-bytes", type=int, default=MIN_FREE_BYTES)
    parser.add_argument("--systemctl-bin", default="/usr/bin/systemctl")
    args = parser.parse_args()

    try:
        data_bytes, free_bytes = usage(args.database_dir)
    except OSError as exc:
        print(f"strfry disk guard: cannot inspect database: {exc}", file=sys.stderr)
        return 1
    safe = data_bytes < args.max_bytes and free_bytes > args.min_free_bytes
    if safe:
        return 0

    print(
        f"strfry disk guard: data={data_bytes} free={free_bytes}; "
        f"limits data<{args.max_bytes} free>{args.min_free_bytes}",
        file=sys.stderr,
    )
    if args.action == "enforce":
        subprocess.run([args.systemctl_bin, "stop", "strfry.service"], check=True)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
